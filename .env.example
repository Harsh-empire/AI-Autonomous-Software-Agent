# AEGIS Server Configuration
HOST=127.0.0.1
PORT=8000
AEGIS_MODEL=qwen2.5-coder:7b
OLLAMA_BASE_URL=http://localhost:11434/v1

# Security Secrets (Generate random hex for production)
SECRET_KEY=change_me_to_a_secure_random_hex_key_in_production

# Optional Settings
PLAYBOOK=on

# --- Optional cloud LLMs (the default is local Ollama: no key, no data leaves your machine) ---
# Never commit real keys. Put them only in your own .env (it is git-ignored) or your shell.
# AEGIS_MODEL=gemini-2.5-flash               # exact model id from Google AI Studio
# GEMINI_API_KEY=
# AEGIS_MODEL=openrouter:<vendor/model>:free  # exact model id from openrouter.ai/models
# OPENROUTER_API_KEY=
# Free tiers have per-minute and per-day limits. Retries use exponential backoff;
# set a minimum number of seconds between calls to stay under requests-per-minute limits:
# AEGIS_LLM_MIN_INTERVAL=6
# AEGIS_LLM_MAX_RETRIES=5
